# Copie este arquivo para .env (não envie o .env ao GitHub) e preencha.

# Login do administrador
ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Texto longo e aleatório (mínimo 16 caracteres), usado para assinar a sessão.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Banco de agendamentos: Supabase (recomendado)
# Painel do Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a chave "service_role" (secreta). NUNCA a coloque no front-end nem no GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Alternativa ao Supabase: Upstash Redis (ignorado se o Supabase estiver configurado)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
